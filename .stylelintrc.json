{
  "extends": [
    "stylelint-config-standard",
    "stylelint-plugin-logical-css/configs/recommended"
  ],
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "apply",
          "config",
          "custom-variant",
          "plugin",
          "reference",
          "screen",
          "source",
          "tailwind",
          "theme",
          "utility",
          "variant"
        ]
      }
    ],
    "at-rule-prelude-no-invalid": [
      true,
      {
        "ignoreAtRules": [
          "apply"
        ]
      }
    ],
    "import-notation": "string",
    "no-invalid-position-at-import-rule": [
      true,
      {
        "ignoreAtRules": [
          "plugin",
          "source",
          "tailwind"
        ]
      }
    ],
    "selector-id-pattern": "^(?:[a-z][a-z0-9]*)(?:[-_][a-z0-9]+)*$"
  }
}
